# Copy to .env and replace every CHANGE_ME value. Never commit .env.
# Use URL-safe generated passwords (letters, digits, '-' and '_').
DOMAIN=scm.example.com
ALLOWED_HOSTS=scm.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://scm.example.com
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe_64
FIELD_ENCRYPTION_KEY=CHANGE_ME_generate_with_Fernet_generate_key
POSTGRES_PASSWORD=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
MFA_REQUIRED=true
TRUST_PROXY_IP=true
